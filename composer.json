{
  "name": "maringotka/website",
  "description": "Maringotka na Zavadke - Nette application",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "ext-intl": "*",
    "ext-pdo_pgsql": "*",
    "latte/latte": "^3.0",
    "nette/application": "^3.2",
    "nette/bootstrap": "^3.2",
    "nette/database": "^3.2",
    "nette/di": "^3.2",
    "nette/mail": "^4.0",
    "tracy/tracy": "^2.10"
  },
  "require-dev": {
    "nette/tester": "^2.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "scripts": {
    "test": "tester tests -p php",
    "analyse": "phpstan analyse --no-progress",
    "check": ["@analyse", "@test"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
