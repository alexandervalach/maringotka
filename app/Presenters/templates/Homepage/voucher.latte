{block content}
<main id="main" class="inner-page container">
    <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
    <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
    <h1>{_'messages.navigation.voucher'}</h1>
    <p class="page-lead">{_'messages.sections.voucher.text'}</p>
    <div class="info-card"><h2>{_'messages.voucher.heading'}</h2>
        <ul class="feature-list"><li>{_'messages.voucher.stay'}</li><li>{_'messages.voucher.wellness'}</li><li>{_'messages.voucher.wine'}</li><li>{_'messages.voucher.validity'}</li></ul>
        <p class="subtle-note">{_'messages.voucher.notAvailable'}</p>
    </div>
</main>
{/block}
