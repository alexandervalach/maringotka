{block content}
<main id="main" class="inner-page container">
    <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
    <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
    <h1>{_'messages.navigation.pricing'}</h1>
    <p class="page-lead">{_'messages.sections.pricing.text'}</p>
    <div class="info-card"><h2>{_'messages.pricing.seasons'}</h2><p>{_'messages.pricing.seasonsNote'}</p></div>
    <h2 class="section-heading">{_'messages.pricing.extras'}</h2>
    <div class="price-list">
        <div><span>{_'messages.pricing.sauna'}</span><strong>{_'messages.pricing.included'}</strong></div>
        <div><span>{_'messages.pricing.tub'}</span><strong>15 € / {_'messages.pricing.day'}</strong></div>
        <div><span>{_'messages.pricing.breakfast'}</span><strong>{_'messages.pricing.tbd'}</strong></div>
        <div><span>{_'messages.pricing.bikes'}</span><strong>{_'messages.pricing.tbd'}</strong></div>
        <div><span>{_'messages.pricing.romance'}</span><strong>{_'messages.pricing.tbd'}</strong></div>
    </div>
    <p class="subtle-note">{_'messages.pricing.notice'}</p>
</main>
{/block}
