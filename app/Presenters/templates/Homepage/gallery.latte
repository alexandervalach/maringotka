{block content}
<main id="main" class="inner-page container">
    <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
    <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
    <h1>{_'messages.navigation.gallery'}</h1>
    <p class="page-lead">{_'messages.sections.gallery.text'}</p>
    <div class="gallery-grid" aria-label="{_'messages.gallery.photos'}">
      <figure class="gallery-photo">
        <picture><source type="image/webp" srcset="/assets/images/media/hero-480.webp 480w, /assets/images/media/hero-960.webp 960w, /assets/images/media/hero-1600.webp 1600w, /assets/images/media/hero-2048.webp 2048w" sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 33vw"><img src="/assets/images/media/hero-1600.jpg" width="2048" height="1365" alt="{_'messages.media.hero'}" loading="lazy" decoding="async"></picture>
      </figure>
      <figure class="gallery-photo">
        <picture><source type="image/webp" srcset="/assets/images/media/interior-480.webp 480w, /assets/images/media/interior-960.webp 960w, /assets/images/media/interior-1600.webp 1600w, /assets/images/media/interior-2048.webp 2048w" sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 33vw"><img src="/assets/images/media/interior-1600.jpg" width="2048" height="1365" alt="{_'messages.media.interior'}" loading="lazy" decoding="async"></picture>
      </figure>
      <figure class="gallery-photo">
        <picture><source type="image/webp" srcset="/assets/images/media/exterior-wide-480.webp 480w, /assets/images/media/exterior-wide-960.webp 960w, /assets/images/media/exterior-wide-1600.webp 1600w, /assets/images/media/exterior-wide-2048.webp 2048w" sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 33vw"><img src="/assets/images/media/exterior-wide-1600.jpg" width="2048" height="1151" alt="{_'messages.media.exterior'}" loading="lazy" decoding="async"></picture>
      </figure>
      <figure class="gallery-photo">
        <picture><source type="image/webp" srcset="/assets/images/media/exterior-portrait-480.webp 480w, /assets/images/media/exterior-portrait-960.webp 960w" sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 33vw"><img src="/assets/images/media/exterior-portrait-1535.jpg" width="1535" height="2048" alt="{_'messages.media.exterior'}" loading="lazy" decoding="async"></picture>
      </figure>
      <figure class="gallery-photo">
        <picture><source type="image/webp" srcset="/assets/images/media/wellness-480.webp 480w, /assets/images/media/wellness-960.webp 960w, /assets/images/media/wellness-1600.webp 1600w, /assets/images/media/wellness-2048.webp 2048w" sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 33vw"><img src="/assets/images/media/wellness-1600.jpg" width="2048" height="1536" alt="{_'messages.media.wellness'}" loading="lazy" decoding="async"></picture>
      </figure>
      <figure class="gallery-photo">
        <picture><source type="image/webp" srcset="/assets/images/media/lights-480.webp 480w, /assets/images/media/lights-960.webp 960w, /assets/images/media/lights-1600.webp 1600w, /assets/images/media/lights-2048.webp 2048w" sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 33vw"><img src="/assets/images/media/lights-1600.jpg" width="2048" height="1365" alt="{_'messages.media.lights'}" loading="lazy" decoding="async"></picture>
      </figure>
    </div>
</main>
{/block}
