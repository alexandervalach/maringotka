{block content}
<main id="main" class="inner-page container">
    <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
    <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
    <h1>{_'messages.navigation.gallery'}</h1>
    <p class="page-lead">{_'messages.sections.gallery.text'}</p>
    <div class="gallery-grid" aria-label="{_'messages.gallery.photos'}">
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/interior-1-480.webp 480w, /assets/images/media/interior-1-960.webp 960w, /assets/images/media/interior-1-1600.webp 1600w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/interior-1-1600.jpg" width="2048" height="1365" alt="{_'messages.media.interior1'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/interior-2-480.webp 480w, /assets/images/media/interior-2-960.webp 960w, /assets/images/media/interior-2-1600.webp 1600w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/interior-2-1600.jpg" width="2048" height="1365" alt="{_'messages.media.interior2'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/interior-480.webp 480w, /assets/images/media/interior-960.webp 960w, /assets/images/media/interior-1600.webp 1600w, /assets/images/media/interior-2048.webp 2048w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/interior-1600.jpg" width="2048" height="1365" alt="{_'messages.media.interior'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/interior-4-480.webp 480w, /assets/images/media/interior-4-960.webp 960w, /assets/images/media/interior-4-1600.webp 1600w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/interior-4-1600.jpg" width="2048" height="1365" alt="{_'messages.media.interior4'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/exterior-wide-480.webp 480w, /assets/images/media/exterior-wide-960.webp 960w, /assets/images/media/exterior-wide-1600.webp 1600w, /assets/images/media/exterior-wide-2048.webp 2048w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/exterior-wide-1600.jpg" width="2048" height="1151" alt="{_'messages.media.exterior'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/exterior-2-480.webp 480w, /assets/images/media/exterior-2-960.webp 960w, /assets/images/media/exterior-2-1600.webp 1600w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/exterior-2-1600.jpg" width="2048" height="1365" alt="{_'messages.media.exterior2'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/exterior-portrait-480.webp 480w, /assets/images/media/exterior-portrait-960.webp 960w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/exterior-portrait-1535.jpg" width="1535" height="2048" alt="{_'messages.media.exterior'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/exterior-4-480.webp 480w, /assets/images/media/exterior-4-960.webp 960w, /assets/images/media/exterior-4-1600.webp 1600w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/exterior-4-1600.jpg" width="2048" height="1536" alt="{_'messages.media.exterior4'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/exterior-front-480.webp 480w, /assets/images/media/exterior-front-960.webp 960w, /assets/images/media/exterior-front-1600.webp 1600w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/exterior-front-1600.jpg" width="2048" height="1365" alt="{_'messages.media.exteriorFront'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/wellness-480.webp 480w, /assets/images/media/wellness-960.webp 960w, /assets/images/media/wellness-1600.webp 1600w, /assets/images/media/wellness-2048.webp 2048w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/wellness-1600.jpg" width="2048" height="1536" alt="{_'messages.media.wellness'}" loading="lazy" decoding="async">
        </picture>
      </figure>
      <figure class="gallery-photo">
        <picture>
          <source type="image/webp" srcset="/assets/images/media/view-tatras-480.webp 480w, /assets/images/media/view-tatras-960.webp 960w" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          <img src="/assets/images/media/view-tatras-1535.jpg" width="1535" height="2048" alt="{_'messages.media.viewTatras'}" loading="lazy" decoding="async">
        </picture>
      </figure>
    </div>
</main>
{/block}
