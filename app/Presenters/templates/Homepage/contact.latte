{block content}
<main id="main" class="inner-page container">
    <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
    <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
    <h1>{_'messages.navigation.contact'}</h1>
    <p class="page-lead">{_'messages.sections.contact.text'}</p>
    <div class="info-card"><h2>{_'messages.contact.details'}</h2><p>{_'messages.contact.pending'}</p>
        <p><a href="https://www.booking.com/hotel/sk/maringotka-na-zavadke-zavadka.sk.html" rel="noopener noreferrer" target="_blank">Booking.com ↗</a></p>
        <p><a href="https://www.google.com/maps/search/?api=1&amp;query=Zavadka%20Gelnica%20Slovakia" rel="noopener noreferrer" target="_blank">{_'messages.contact.map'} ↗</a></p>
    </div>
</main>
{/block}
