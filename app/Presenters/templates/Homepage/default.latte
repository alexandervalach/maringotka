{block content}
<main id="main" class="site-main">
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content container">
            <p class="eyebrow">{_'messages.hero.tagline'}</p>
            <h1 id="hero-title">{_'messages.hero.headline'}</h1>
            <p class="hero-lead">{_'messages.hero.intro'}</p>
            <a href="{$paths['booking']}" class="button">{_'messages.navigation.booking'} <span aria-hidden="true">→</span></a>
            <p class="hero-note">{_'messages.hero.placeholder'}</p>
        </div>
        <div class="hero-art" aria-hidden="true"><div class="art-sun"></div><div class="art-ridge ridge-back"></div><div class="art-ridge ridge-front"></div></div>
    </section>
    <section class="intro-strip"><div class="container">
        <span>{_'messages.hero.location'}</span>
        <span>{_'messages.hero.capacity'}</span>
        <span>{_'messages.hero.wellness'}</span>
    </div></section>
    <section class="container page-preview" aria-label="{_'messages.common.explore'}">
        <a href="{$paths['gallery']}">{_'messages.navigation.gallery'} →</a>
        <a href="{$paths['surroundings']}">{_'messages.navigation.surroundings'} →</a>
        <a href="{$paths['pricing']}">{_'messages.navigation.pricing'} →</a>
        <a href="{$paths['voucher']}">{_'messages.navigation.voucher'} →</a>
        <a href="{$paths['contact']}">{_'messages.navigation.contact'} →</a>
    </section>
</main>
{/block}
