{block content}
<main id="main" class="inner-page container">
    <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
    <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
    <h1>{_'messages.navigation.surroundings'}</h1>
    <p class="page-lead">{_'messages.sections.surroundings.text'}</p>
    <div class="place-grid">
        <article class="place-card"><h2>{_'messages.surroundings.tatras'}</h2><p>{_'messages.surroundings.tatrasText'}</p></article>
        <article class="place-card"><h2>{_'messages.surroundings.chapel'}</h2><p>{_'messages.surroundings.chapelText'}</p></article>
        <article class="place-card"><h2>{_'messages.surroundings.nalepkovo'}</h2><p>{_'messages.surroundings.nalepkovoText'}</p></article>
        <article class="place-card"><h2>{_'messages.surroundings.hnilcik'}</h2><p>{_'messages.surroundings.hnilcikText'}</p></article>
        <article class="place-card"><h2>{_'messages.surroundings.paradise'}</h2><p>{_'messages.surroundings.paradiseText'}</p></article>
        <article class="place-card"><h2>{_'messages.surroundings.spisska'}</h2><p>{_'messages.surroundings.spisskaText'}</p></article>
    </div>
</main>
{/block}
