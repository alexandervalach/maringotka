{layout none}
<!doctype html>
<html lang="sk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Správa rezervácií – Maringotka na Závadke</title>
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="stylesheet" href="/assets/css/booking-management.css">
</head>
<body>
<main class="container inner-page cms-editor booking-admin-page">
  <nav aria-label="Administrácia"><a class="back-link" href="/admin">← Administrácia</a></nav>
  <section class="info-card">
    <h1>Rezervácie</h1>
    <p class="page-lead">Prehľad všetkých žiadostí. Čakajúce aj potvrdené rezervácie blokujú termín.</p>
    <p n:foreach="$flashes as $flash" role="status" class="subtle-note">{$flash->message}</p>

    <form method="get" action="/admin/bookings" class="booking-admin-filters" role="search">
      <div class="booking-admin-filter">
        <label for="booking-status-filter">Stav rezervácie</label>
        <select name="status" id="booking-status-filter">
          <option value="" selected={$statusFilter === ''}>Všetky stavy</option>
          <option value="pending" selected={$statusFilter === 'pending'}>Čaká na potvrdenie</option>
          <option value="confirmed" selected={$statusFilter === 'confirmed'}>Potvrdená</option>
          <option value="rejected" selected={$statusFilter === 'rejected'}>Zamietnutá</option>
          <option value="cancelled" selected={$statusFilter === 'cancelled'}>Zrušená</option>
        </select>
      </div>
      <div class="booking-admin-filter booking-admin-search">
        <label for="booking-admin-search">Číslo, meno alebo e-mail</label>
        <input type="search" id="booking-admin-search" name="q" value="{$searchTerm}" maxlength="100" placeholder="Hľadať rezerváciu">
      </div>
      <button class="button" type="submit">Vyhľadať</button>
      <a class="booking-admin-reset" href="/admin/bookings">Vymazať filtre</a>
    </form>

    <div class="booking-admin-table-scroll" role="region" aria-label="Prehľad rezervácií" tabindex="0">
      <table class="booking-admin-table booking-admin-table--colored">
        <thead>
          <tr>
            <th scope="col">Číslo</th>
            <th scope="col">Príchod</th>
            <th scope="col">Odchod</th>
            <th scope="col">Meno a priezvisko</th>
            <th scope="col">E-mail</th>
            <th scope="col">Telefón</th>
            <th scope="col">Poznámka</th>
            <th scope="col">Rozhodnuté</th>
            <th scope="col">Dôvod zamietnutia</th>
            <th scope="col">Vytvorená</th>
            <th scope="col">Akcie</th>
          </tr>
        </thead>
        <tbody>
          {foreach $requests as $request}
            <tr class="booking-admin-row booking-admin-row--{$request['status']}">
              <th scope="row" class="booking-admin-number">
                {if $request['status'] === 'pending'}
                  <span class="booking-admin-status-icon" aria-label="Čaká na potvrdenie" title="Čaká na potvrdenie">◷</span>
                {elseif $request['status'] === 'confirmed'}
                  <span class="booking-admin-status-icon" aria-label="Potvrdená" title="Potvrdená">✓</span>
                {elseif $request['status'] === 'rejected'}
                  <span class="booking-admin-status-icon" aria-label="Zamietnutá" title="Zamietnutá">✕</span>
                {else}
                  <span class="booking-admin-status-icon" aria-label="Zrušená" title="Zrušená">–</span>
                {/if}
                <span>#{$request['id']}</span>
              </th>
              <td class="booking-admin-nowrap">{$request['arrival_date']|date:'d. m. Y'}</td>
              <td class="booking-admin-nowrap">{$request['departure_date']|date:'d. m. Y'}</td>
              <td>{$request['guest_name']}</td>
              <td class="booking-admin-email"><a href="mailto:{$request['guest_email']}">{$request['guest_email']}</a></td>
              <td class="booking-admin-nowrap">{$request['guest_phone'] ?: '—'}</td>
              <td class="booking-admin-longtext">{$request['guest_note'] ?: '—'}</td>
              <td class="booking-admin-nowrap">{if $request['decided_at']}{$request['decided_at']|date:'d. m. Y H:i'}{else}—{/if}</td>
              <td class="booking-admin-longtext">{$request['decision_reason'] ?: '—'}</td>
              <td class="booking-admin-nowrap">{$request['created_at']|date:'d. m. Y H:i'}</td>
              <td class="booking-admin-action">
                <details class="booking-admin-actions">
                  <summary>Akcie</summary>
                  <div class="booking-admin-actions-menu">
                    <a n:href="edit, id: $request['id']">{if $request['status'] === 'pending'}Vybaviť rezerváciu{else}Detail rezervácie{/if}</a>
                    <a href="mailto:{$request['guest_email']}">Kontaktovať hosťa</a>
                  </div>
                </details>
              </td>
            </tr>
          {else}
            <tr><td colspan="11" class="booking-admin-empty">Pre zvolené filtre sa nenašli žiadne rezervácie.</td></tr>
          {/foreach}
        </tbody>
      </table>
    </div>
    <nav class="booking-admin-pagination" aria-label="Stránkovanie rezervácií">
      <div>
        {if $newerCursor !== null}
          <a class="button" n:href="default, status: $statusFilter, q: $searchTerm, after: $newerCursor, before: null">← Novšie</a>
        {/if}
      </div>
      <span>Najviac 25 rezervácií na stránku</span>
      <div>
        {if $olderCursor !== null}
          <a class="button" n:href="default, status: $statusFilter, q: $searchTerm, before: $olderCursor, after: null">Staršie →</a>
        {/if}
      </div>
    </nav>
  </section>
</main>
</body>
</html>
