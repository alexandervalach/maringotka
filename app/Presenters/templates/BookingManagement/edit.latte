{layout '../@admin.latte'}

{block pageTitle}Rozhodnutie o rezervácii{/block}

{block content}
<main class="container inner-page cms-editor">
  <nav aria-label="Administrácia"><a class="back-link" href="{$bookingBackUrl}">← Späť na prehľad rezervácií</a></nav>
  <section class="info-card">
    <h1>Rezervácia č. {$request['id']}</h1>
    <p><strong>Termín:</strong> {$request['arrival_date']|date:'d. m. Y'} – {$request['departure_date']|date:'d. m. Y'}</p>
    <p><strong>Stav:</strong> {$request['status']}</p>
    <p><strong>Meno:</strong> {$request['guest_name']}</p>
    <p><strong>E-mail:</strong> {$request['guest_email']}</p>
    <p><strong>Telefón:</strong> {$request['guest_phone'] ?: '—'}</p>
    <p><strong>Poznámka:</strong> {$request['guest_note'] ?: '—'}</p>
    {if $request['status'] === 'pending' || $request['status'] === 'confirmed'}
      {if $request['status'] === 'confirmed'}
        <p>Potvrdená rezervácia. Môžete ju zrušiť po dohode s hosťom. Termín sa následne uvoľní.</p>
      {/if}
      <div class="cms-form booking-admin-form">
        {form decisionForm}
          <ul class="cms-form-errors" n:if="$form->hasErrors()">
            <li n:foreach="$form->getErrors() as $error">{$error}</li>
          </ul>
          <fieldset class="booking-decision-fieldset">
            <legend>Rozhodnutie</legend>
            <div class="booking-decision-options">
              {foreach $form[decision]->getItems() as $key => $caption}
                <label n:name="decision:$key" class="booking-decision-option booking-decision-option--{$key}">
                  <input n:name="decision:$key" class="booking-decision-option__input">
                  <span class="booking-decision-option__surface">
                    <span class="booking-decision-option__icon" aria-hidden="true">
                      {if $key === 'confirmed'}✓{elseif $key === 'rejected'}✕{else}⊘{/if}
                    </span>
                    <span>{$caption}</span>
                  </span>
                </label>
              {/foreach}
            </div>
            <span class="cms-form-error" n:ifcontent>{inputError decision}</span>
          </fieldset>
          <p>Pri zamietnutí alebo zrušení uveďte dôvod. Zrušenie je nevratné.</p>
          {label reason /}
          {input reason}
          {input save}
        {/form}
      </div>
    {else}
      <p>Túto rezerváciu už nemožno ďalej meniť.</p>
      {if $request['decision_reason']}<p><strong>Dôvod rozhodnutia:</strong> {$request['decision_reason']}</p>{/if}
    {/if}
  </section>

  <section class="info-card booking-payment" aria-labelledby="booking-payment-heading">
    <div class="booking-payment__heading">
      <div>
        <h2 id="booking-payment-heading">Platba za pobyt</h2>
        <p class="booking-payment__hint">Platby sa overujú podľa bankového účtu a označujú administrátorom.</p>
      </div>
      <a class="booking-payment__settings" href="/admin/payment-settings">Nastavenie účtu</a>
    </div>

    {if $payment === null}
      <p>Platobné údaje rezervácie nie sú dostupné.</p>
    {else}
      <div class="booking-payment__overview">
        <div>
          <span>Suma za pobyt</span>
          <strong>{$paymentAmount ?? 'Cena nie je dostupná'}</strong>
        </div>
        <div>
          <span>Variabilný symbol</span>
          <strong>{$payment['variable_symbol']}</strong>
        </div>
        <div class="booking-payment__overview-status booking-payment__overview-status--{$payment['status']}">
          <span>Stav úhrady</span>
          <strong class="booking-payment__status booking-payment__status--{$payment['status']}">
            {if $payment['status'] === 'paid'}Zaplatená{else}Nezaplatená{/if}
          </strong>
        </div>
      </div>

      {if $payment['paid_at'] !== null && $payment['status'] === 'paid'}
        <p class="booking-payment__hint">Označená ako zaplatená: {$payment['paid_at']|date:'d. m. Y H:i'}</p>
      {/if}

      {if $request['status'] === 'confirmed' && $payment['total_cents'] !== null}
        <div class="cms-form booking-payment__form">
          {form paymentForm}
            <ul class="cms-form-errors" n:if="$form->hasErrors()">
              <li n:foreach="$form->getErrors() as $error">{$error}</li>
            </ul>

            {if $payment['status'] === 'unpaid'}
              {input markPaid}
            {else}
              {input markUnpaid}
            {/if}
          {/form}
        </div>
      {elseif $payment['total_cents'] === null}
        <p class="booking-payment__hint">K tejto rezervácii nie je uložená cena; úhradu zatiaľ nemožno označiť.</p>
      {/if}

      {if $paymentAccount['iban'] !== null && $paymentAccount['account_holder'] !== null}
        <h3 class="booking-payment__bank-heading">Údaje na bankový prevod</h3>
        <dl class="booking-payment__bank">
          <div><dt>Príjemca</dt><dd>{$paymentAccount['account_holder']}</dd></div>
          <div><dt>IBAN</dt><dd><code>{$paymentAccount['iban']}</code></dd></div>
          {if $paymentAccount['bic'] !== null}
            <div><dt>BIC / SWIFT</dt><dd>{$paymentAccount['bic']}</dd></div>
          {/if}
          <div><dt>Správa pre príjemcu</dt><dd>Rezervácia {$request['id']}, VS {$payment['variable_symbol']}</dd></div>
        </dl>
      {else}
        <p class="booking-payment__warning">Bankový účet ešte nie je nastavený. Platobné pokyny zatiaľ neposielajte.</p>
      {/if}

      {if $paymentQrAvailable && $paymentQrDataUri === null}
        <div class="booking-payment__qr">
          {if $paymentQrConfigured}
            <div class="cms-form">
              <h3>PAY by square</h3>
              <p class="booking-payment__hint">QR zatiaľ nie je uložený. Môžete ho pripraviť aj samostatne.</p>
              {form qrForm}
                <ul class="cms-form-errors" n:if="$form->hasErrors()">
                  <li n:foreach="$form->getErrors() as $error">{$error}</li>
                </ul>
                {input generate}
              {/form}
            </div>
          {else}
            <p class="booking-payment__hint">PAY by square nie je nakonfigurovaný. Bankový prevod funguje aj bez QR kódu.</p>
          {/if}
        </div>
      {/if}

      {if $paymentQrDataUri !== null}
        <div class="booking-payment__qr">
          <div>
            <h3>PAY by square</h3>
            <p class="booking-payment__hint">QR kód je uložený pre aktuálne platobné údaje.</p>
            <a class="button booking-payment__action" href="{$paymentQrDataUri|nocheck}" download="rezervacia-{$request['id']}-pay-by-square.png">Stiahnuť QR kód</a>
          </div>
          <img class="booking-payment__qr-image" src="{$paymentQrDataUri|nocheck}" width="200" height="200" alt="PAY by square QR kód pre rezerváciu č. {$request['id']}">
        </div>
      {/if}

      {if $paymentQrAvailable && $paymentEmailConfigured && $payment['status'] === 'unpaid'}
        <div class="booking-payment__form cms-form">
          <h3>Platobné pokyny hosťovi</h3>
          {if $paymentEmailHistory['sent_at'] !== null}
            <p class="booking-payment__hint">Posledné odoslanie: {$paymentEmailHistory['sent_at']} · Odoslané {$paymentEmailHistory['count']}×.</p>
          {/if}
          {form paymentEmailForm}
            <ul class="cms-form-errors" n:if="$form->hasErrors()">
              <li n:foreach="$form->getErrors() as $error">{$error}</li>
            </ul>
            {input send}
          {/form}
        </div>
      {/if}
    {/if}
  </section>

  {control bookingQuote, $request}

  <section class="info-card booking-history" aria-labelledby="booking-history-heading">
    <h2 id="booking-history-heading">História rezervácie</h2>
    {if $bookingHistory}
      <div class="booking-history-scroll">
        <table class="booking-history-table">
          <thead>
            <tr>
              <th scope="col">Dátum a čas</th>
              <th scope="col">Udalosť</th>
              <th scope="col">Podrobnosti</th>
            </tr>
          </thead>
          <tbody>
            {foreach $bookingHistory as $event}
              <tr>
                <td>{$event['occurred_at']|date:'d. m. Y H:i:s'}</td>
                <td>
                  {if $event['event_type'] === 'status'}
                    {if $event['previous_status'] === null}Zaznamenanie rezervácie
                    {elseif $event['current_status'] === 'confirmed'}Rezervácia potvrdená
                    {elseif $event['current_status'] === 'rejected'}Rezervácia zamietnutá
                    {elseif $event['current_status'] === 'cancelled'}Rezervácia zrušená
                    {else}Stav rezervácie zmenený{/if}
                  {elseif $event['event_type'] === 'payment_paid'}Platba označená ako prijatá
                  {elseif $event['event_type'] === 'payment_unpaid'}Platba označená ako nezaplatená
                  {elseif $event['event_type'] === 'mail_sent'}E-mail odoslaný
                  {elseif $event['event_type'] === 'qr_generated'}QR kód vygenerovaný
                  {elseif $event['event_type'] === 'mail_summary'}Staršie odoslanie e-mailu
                  {else}Udalosť rezervácie{/if}
                </td>
                <td>
                  {if $event['event_type'] === 'status'}
                    {if $event['previous_status'] !== null}
                      {if $event['previous_status'] === 'pending'}Čakajúca
                      {elseif $event['previous_status'] === 'confirmed'}Potvrdená
                      {elseif $event['previous_status'] === 'rejected'}Zamietnutá
                      {elseif $event['previous_status'] === 'cancelled'}Zrušená
                      {else}{$event['previous_status']}{/if}
                      →
                    {/if}
                    {if $event['current_status'] === 'pending'}Čakajúca
                    {elseif $event['current_status'] === 'confirmed'}Potvrdená
                    {elseif $event['current_status'] === 'rejected'}Zamietnutá
                    {elseif $event['current_status'] === 'cancelled'}Zrušená
                    {else}{$event['current_status']}{/if}
                    {if $event['detail']} – {$event['detail']}{/if}
                  {else}
                    {$event['detail'] ?: '—'}
                  {/if}
                </td>
              </tr>
            {/foreach}
          </tbody>
        </table>
      </div>
      <p class="booking-history-note">Staršie udalosti doplnené migráciou môžu mať dátum záznamu namiesto pôvodného času. Chýbajúce udalosti spätne nedopĺňame odhadom.</p>
    {else}
      <p>Zatiaľ nie sú dostupné zaznamenané udalosti rezervácie.</p>
    {/if}
  </section>
</main>
{/block}
