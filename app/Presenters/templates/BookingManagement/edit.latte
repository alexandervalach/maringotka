{layout '../@admin.latte'}

{block pageTitle}Rozhodnutie o rezervácii{/block}

{block content}
<main class="container inner-page cms-editor">
  <nav aria-label="Administrácia"><a class="back-link" href="{$bookingBackUrl}">← Späť na prehľad rezervácií</a></nav>
  <section class="info-card">
    <h1>Rezervácia č. {$request['id']}</h1>
    <p><strong>Termín:</strong> {$request['arrival_date']|date:'d. m. Y'} – {$request['departure_date']|date:'d. m. Y'}</p>
    <p><strong>Stav:</strong> {$request['status']}</p>
    <p><strong>Meno:</strong> {$request['guest_name']}</p>
    <p><strong>E-mail:</strong> {$request['guest_email']}</p>
    <p><strong>Telefón:</strong> {$request['guest_phone'] ?: '—'}</p>
    <p><strong>Poznámka:</strong> {$request['guest_note'] ?: '—'}</p>
    {if $request['status'] === 'pending' || $request['status'] === 'confirmed'}
      {if $request['status'] === 'confirmed'}
        <p>Potvrdená rezervácia. Môžete ju zrušiť po dohode s hosťom. Termín sa následne uvoľní.</p>
      {/if}
      <div class="cms-form booking-admin-form">
        {form decisionForm}
          <ul class="cms-form-errors" n:if="$form->hasErrors()">
            <li n:foreach="$form->getErrors() as $error">{$error}</li>
          </ul>
          <fieldset class="booking-decision-fieldset">
            <legend>Rozhodnutie</legend>
            <div class="booking-decision-options">
              {foreach $form[decision]->getItems() as $key => $caption}
                <label n:name="decision:$key" class="booking-decision-option booking-decision-option--{$key}">
                  <input n:name="decision:$key" class="booking-decision-option__input">
                  <span class="booking-decision-option__surface">
                    <span class="booking-decision-option__icon" aria-hidden="true">
                      {if $key === 'confirmed'}✓{elseif $key === 'rejected'}✕{else}⊘{/if}
                    </span>
                    <span>{$caption}</span>
                  </span>
                </label>
              {/foreach}
            </div>
            <span class="cms-form-error" n:ifcontent>{inputError decision}</span>
          </fieldset>
          <p>Pri zamietnutí alebo zrušení uveďte dôvod. Zrušenie je nevratné.</p>
          {label reason /}
          {input reason}
          {input save}
        {/form}
      </div>
    {else}
      <p>Túto rezerváciu už nemožno ďalej meniť.</p>
      {if $request['decision_reason']}<p><strong>Dôvod rozhodnutia:</strong> {$request['decision_reason']}</p>{/if}
    {/if}
  </section>

  <section class="info-card booking-payment" aria-labelledby="booking-payment-heading">
    <div class="booking-payment__heading">
      <div>
        <h2 id="booking-payment-heading">Platba za pobyt</h2>
        <p class="booking-payment__hint">Úhrada sa kontroluje manuálne podľa bankového účtu. Stav úhrady nie je stav rezervácie.</p>
      </div>
      <a class="booking-payment__settings" href="/admin/payment-settings">Nastavenie účtu</a>
    </div>
    {if $payment === null}
      <p>Platobné údaje rezervácie nie sú dostupné.</p>
    {else}
      <div class="booking-payment__overview">
        <div><span>Suma</span><strong>{$paymentAmount ?? 'Cena nie je dostupná'}</strong></div>
        <div><span>Variabilný symbol</span><strong>{$payment['variable_symbol']}</strong></div>
        <div><span>Stav úhrady</span><strong class="booking-payment__status booking-payment__status--{$payment['status']}">{if $payment['status'] === 'paid'}Zaplatená{else}Nezaplatená{/if}</strong></div>
      </div>
      {if $payment['paid_at'] !== null}
        <p class="booking-payment__hint">Dátum posledného označenia platby za uhradenú: {$payment['paid_at']|date:'d. m. Y H:i'}</p>
      {/if}
      {if $paymentAccount['iban'] !== null && $paymentAccount['account_holder'] !== null}
        <h3 class="booking-payment__bank-heading">Údaje na bankový prevod</h3>
        <dl class="booking-payment__bank">
          <div><dt>Príjemca</dt><dd>{$paymentAccount['account_holder']}</dd></div>
          <div><dt>IBAN</dt><dd><code>{$paymentAccount['iban']}</code></dd></div>
          {if $paymentAccount['bic'] !== null}<div><dt>BIC / SWIFT</dt><dd>{$paymentAccount['bic']}</dd></div>{/if}
          {if $payment['total_cents'] !== null}<div><dt>Suma v EUR</dt><dd><strong>{$paymentAmount}</strong></dd></div>{/if}
          <div><dt>Variabilný symbol</dt><dd><strong>{$payment['variable_symbol']}</strong></dd></div>
          <div><dt>Správa pre príjemcu</dt><dd>Rezervácia {$request['id']}, VS {$payment['variable_symbol']}</dd></div>
        </dl>
        <p class="booking-payment__hint">Pri manuálnom prevode uveďte variabilný symbol, aby sa úhrada dala priradiť k rezervácii. Číslo faktúry sa vedie samostatne.</p>
      {else}
        <p class="booking-payment__warning">Bankový účet ešte nie je nastavený. Platobné pokyny zákazníkovi zatiaľ neposielajte.</p>
      {/if}
      {if $paymentQrAvailable && $paymentQrDataUri === null}
        <div class="booking-payment__qr">
          {if $paymentQrConfigured}
            <div class="cms-form">
              <h3>PAY by square – slovenský platobný QR kód</h3>
              <p class="booking-payment__hint">QR vygenerujete jednorazovo na vyžiadanie. Pri opätovnom otvorení stránky sa už používa uložený obrázok.</p>
              {form qrForm}
                <ul class="cms-form-errors" n:if="$form->hasErrors()">
                  <li n:foreach="$form->getErrors() as $error">{$error}</li>
                </ul>
                {input generate}
              {/form}
            </div>
          {else}
            <p class="booking-payment__hint">PAY by square nie je aktivovaný. Nastavte BYSQUARE_API_KEY v serverovej konfigurácii. Bežné bankové údaje sú dostupné vyššie.</p>
          {/if}
        </div>
      {/if}
      {if $paymentQrDataUri !== null}
        <div class="booking-payment__qr">
          <div>
            <h3>PAY by square – platba QR kódom</h3>
            <p class="booking-payment__hint">QR kód pre slovenské bankové aplikácie. Pri platbe overte príjemcu, sumu a variabilný symbol. Pre zahraničných hostí sú vyššie dostupné údaje na SEPA prevod.</p>
            <div class="booking-payment__actions">
              <a class="admin-save-button booking-payment__action" href="{$paymentQrDataUri|nocheck}" download="rezervacia-{$request['id']}-pay-by-square.png">Stiahnuť PAY by square QR</a>
            </div>
            <p class="booking-payment__hint">E-mail sa otvorí ako návrh v poštovom programe; neodosiela sa automaticky. QR kód sa neprikladá automaticky.</p>
          </div>
          <img class="booking-payment__qr-image" src="{$paymentQrDataUri|nocheck}" width="200" height="200" alt="PAY by square QR kód pre platbu za rezerváciu č. {$request['id']}">
        </div>
      {/if}
      {if $paymentEmailUrl !== null}
        <p><a class="admin-save-button booking-payment__action" href="{$paymentEmailUrl}">Pripraviť e-mail hosťovi</a></p>
        <p class="booking-payment__hint">E-mail sa iba pripraví v poštovom programe. QR obrázok je potrebné priložiť ručne.</p>
      {/if}
      {if $paymentQrAvailable && $paymentEmailConfigured && $payment['status'] === 'unpaid'}
        <div class="booking-payment__form cms-form">
          <h3>Odoslať platobné pokyny hosťovi</h3>
          <p class="booking-payment__hint">Odošle e-mail na adresu hosťa. Už uložený QR kód bude priložený, nový sa negeneruje. Po úspešnom odoslaní systém zaznamená čas a počet odoslaní. Náhodné opakované odoslanie do piatich minút zablokuje.</p>
          {if $paymentEmailHistory['sent_at'] !== null}
            <p class="booking-payment__hint">Naposledy odoslané: {$paymentEmailHistory['sent_at']} · Počet odoslaní: {$paymentEmailHistory['count']}.</p>
          {/if}
          {form paymentEmailForm}
            <ul class="cms-form-errors" n:if="$form->hasErrors()">
              <li n:foreach="$form->getErrors() as $error">{$error}</li>
            </ul>
            {input send}
          {/form}
        </div>
      {elseif $paymentQrAvailable && !$paymentEmailConfigured}
        <p class="booking-payment__hint">Serverové odosielanie e-mailov nie je nakonfigurované. Môžete použiť návrh e-mailu vyššie.</p>
      {/if}
      {if $request['status'] === 'confirmed' && $payment['total_cents'] !== null}
        <div class="booking-payment__form cms-form">
          {form paymentForm}
            <ul class="cms-form-errors" n:if="$form->hasErrors()">
              <li n:foreach="$form->getErrors() as $error">{$error}</li>
            </ul>
            <fieldset>
              <legend>Manuálne označenie úhrady</legend>
              <label n:name="status:unpaid"><input n:name="status:unpaid" checked={$payment['status'] === 'unpaid'}> Nezaplatená</label>
              <label n:name="status:paid"><input n:name="status:paid" checked={$payment['status'] === 'paid'}> Zaplatená</label>
            </fieldset>
            {input save}
          {/form}
        </div>
      {elseif $payment['total_cents'] === null}
        <p class="booking-payment__hint">Táto staršia rezervácia nemá uloženú cenu, preto nemožno evidovať jej úhradu.</p>
      {else}
        <p class="booking-payment__hint">Stav úhrady možno meniť len pri potvrdenej rezervácii so známou cenou.</p>
      {/if}
    {/if}
  </section>

  {control bookingQuote, $request}

  <section class="info-card booking-history" aria-labelledby="booking-history-heading">
    <h2 id="booking-history-heading">História rezervácie</h2>
    {if $statusHistory}
      <div class="booking-history-scroll">
        <table class="booking-history-table">
          <thead>
            <tr>
              <th scope="col">Dátum a čas</th>
              <th scope="col">Pôvodný stav</th>
              <th scope="col">Nový stav</th>
              <th scope="col">Dôvod</th>
            </tr>
          </thead>
          <tbody>
            {foreach $statusHistory as $event}
              <tr>
                <td>{$event['changed_at']|date:'d. m. Y H:i'}</td>
                <td>
                  {if $event['previous_status'] === null}—
                  {elseif $event['previous_status'] === 'pending'}Čakajúca
                  {elseif $event['previous_status'] === 'confirmed'}Potvrdená
                  {elseif $event['previous_status'] === 'rejected'}Zamietnutá
                  {elseif $event['previous_status'] === 'cancelled'}Zrušená
                  {else}{$event['previous_status']}{/if}
                </td>
                <td>
                  {if $event['current_status'] === 'pending'}Čakajúca
                  {elseif $event['current_status'] === 'confirmed'}Potvrdená
                  {elseif $event['current_status'] === 'rejected'}Zamietnutá
                  {elseif $event['current_status'] === 'cancelled'}Zrušená
                  {else}{$event['current_status']}{/if}
                </td>
                <td>{$event['decision_reason'] ?: '—'}</td>
              </tr>
            {/foreach}
          </tbody>
        </table>
      </div>
      <p class="booking-history-note">Pri udalostiach vytvorených migráciou je časom záznamu dátum migrácie, nie pôvodného rozhodnutia.</p>
    {else}
      <p>Zatiaľ neexistuje žiadna zaznamenaná zmena stavu.</p>
    {/if}
  </section>
</main>
{/block}
