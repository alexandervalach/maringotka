{layout '../@admin.latte'}

{block pageTitle}Rozhodnutie o rezervácii{/block}

{block extraHead}
  <link rel="stylesheet" href="{$basePath}/assets/css/booking-decision.css">
{/block}

{block content}
<main class="container inner-page cms-editor">
  <nav aria-label="Administrácia"><a class="back-link" n:href="default">← Rezervácie</a></nav>
  <section class="info-card">
    <h1>Rezervácia č. {$request['id']}</h1>
    <p><strong>Termín:</strong> {$request['arrival_date']|date:'d. m. Y'} – {$request['departure_date']|date:'d. m. Y'}</p>
    <p><strong>Stav:</strong> {$request['status']}</p>
    <p><strong>Meno:</strong> {$request['guest_name']}</p>
    <p><strong>E-mail:</strong> {$request['guest_email']}</p>
    <p><strong>Telefón:</strong> {$request['guest_phone'] ?: '—'}</p>
    <p><strong>Poznámka:</strong> {$request['guest_note'] ?: '—'}</p>
    {if $request['status'] === 'pending' || $request['status'] === 'confirmed'}
      {if $request['status'] === 'confirmed'}
        <p>Potvrdená rezervácia. Môžete ju zrušiť po dohode s hosťom. Termín sa následne uvoľní.</p>
      {/if}
      <div class="cms-form booking-admin-form">
        {form decisionForm}
          <ul class="cms-form-errors" n:if="$form->hasErrors()">
            <li n:foreach="$form->getErrors() as $error">{$error}</li>
          </ul>
          <fieldset class="booking-decision-fieldset">
            <legend>Rozhodnutie</legend>
            <div class="booking-decision-options">
              {foreach $form[decision]->getItems() as $key => $caption}
                <label n:name="decision:$key" class="booking-decision-option booking-decision-option--{$key}">
                  <input n:name="decision:$key" class="booking-decision-option__input">
                  <span class="booking-decision-option__surface">
                    <span class="booking-decision-option__icon" aria-hidden="true">
                      {if $key === 'confirmed'}✓{elseif $key === 'rejected'}✕{else}⊘{/if}
                    </span>
                    <span>{$caption}</span>
                  </span>
                </label>
              {/foreach}
            </div>
            <span class="cms-form-error" n:ifcontent>{inputError decision}</span>
          </fieldset>
          <p>Pri zamietnutí alebo zrušení uveďte dôvod. Zrušenie je nevratné.</p>
          {label reason /}
          {input reason}
          {input save}
        {/form}
      </div>
    {else}
      <p>Túto rezerváciu už nemožno ďalej meniť.</p>
      {if $request['decision_reason']}<p><strong>Dôvod rozhodnutia:</strong> {$request['decision_reason']}</p>{/if}
    {/if}
  </section>
</main>
{/block}
