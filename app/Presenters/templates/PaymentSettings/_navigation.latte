<nav class="mail-template-picker" aria-label="Výber e-mailovej šablóny">
  <a class="mail-template-picker__item" href="/admin/mail-templates/received" {if $current === 'received'}aria-current="page"{/if}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18v14H3z"/><path d="m3 7 9 6 9-6"/><path d="M12 2v7m-3-3 3 3 3-3"/></svg>
    <span><strong>Prijatie žiadosti o rezerváciu</strong><small>Potvrdenie, že žiadosť bola prijatá</small></span>
  </a>
  <a class="mail-template-picker__item" href="/admin/mail-templates/confirmed" {if $current === 'confirmed'}aria-current="page"{/if}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="17" rx="2"/><path d="M8 2v4m8-4v4M4 9h16"/><circle cx="12" cy="15" r="2"/></svg>
    <span><strong>Potvrdenie rezervácie</strong><small>Schválenie rezervácie a informácie o platbe</small></span>
  </a>
  <a class="mail-template-picker__item" href="/admin/mail-templates/paid" {if $current === 'paid'}aria-current="page"{/if}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2h14v20l-3-2-4 2-4-2-3 2z"/><path d="M8 7h8m-8 4h8m-8 5h5"/><path d="M16.7 15.7c-.4.4-.9.6-1.5.6a2 2 0 0 1 0-4c.6 0 1.1.2 1.5.6"/></svg>
    <span><strong>Potvrdenie prijatia platby</strong><small>Automaticky po označení úhrady, faktúra v PDF</small></span>
  </a>
</nav>
