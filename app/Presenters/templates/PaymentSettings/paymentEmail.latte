{layout '../@admin.latte'}
{block pageTitle}Mailové šablóny – Platobné pokyny{/block}
{block content}
<main class="container inner-page cms-editor booking-payment-settings">
  <nav aria-label="Administrácia"><a class="back-link" href="/admin">← Späť do administrácie</a></nav>
  <section class="info-card">
    <h1>Mailové šablóny</h1>
    <p class="page-lead">Vyberte šablónu na úpravu.</p>
    {include '_navigation.latte', current: 'payment'}
  </section>
  <section class="info-card">
    <h2>Platobné pokyny</h2>
    <p class="booking-payment__hint">Tento e-mail sa odosiela po manuálnom rozhodnutí administrátora. Podporuje jednoduchý Markdown: <code>**tučné**</code>, <code>*kurzíva*</code>, nadpis <code># </code> a odseky. Vlastné HTML a odkazy nie sú povolené.</p>
    <p class="booking-payment__hint">Značky: <code>{= '{{booking_id}}'}</code>, <code>{= '{{holder}}'}</code>, <code>{= '{{iban}}'}</code>, <code>{= '{{bic}}'}</code>, <code>{= '{{amount}}'}</code>, <code>{= '{{variable_symbol}}'}</code>. Príjemca, IBAN, suma a VS musia zostať v texte.</p>
    {foreach $flashes as $flash}<p role="status" class="booking-payment__notice">{$flash->message}</p>{/foreach}
    <div class="cms-form booking-payment-settings__form">
      {form emailTemplateForm}
        <ul class="cms-form-errors" n:if="$form->hasErrors()">
          <li n:foreach="$form->getErrors() as $error">{$error}</li>
        </ul>
        {label subject /}{input subject}
        {label body /}{input body}
        <div>{input show_logo}{label show_logo /}</div>
        <div>{input save} {input restore}</div>
      {/form}
    </div>
    <h3>Náhľad uloženej šablóny (fiktívne údaje)</h3>
    <p><strong>Predmet:</strong> {$emailPreviewSubject}</p>
    <iframe title="Náhľad platobného e-mailu" sandbox="" srcdoc="{$emailPreviewHtml}" style="width:100%;min-height:450px;border:1px solid #ddd;border-radius:10px;background:#fff"></iframe>
    <p class="booking-payment__hint">Náhľad sa aktualizuje po uložení. Logo sa v skutočnom e-maile priloží z existujúceho súboru webu.</p>
  </section>
</main>
{/block}
