{layout '../@admin.latte'}
{block pageTitle}Mailové šablóny – Potvrdenie prijatia platby{/block}
{block content}
<main class="container inner-page cms-editor booking-payment-settings">
  <nav aria-label="Administrácia"><a class="back-link" href="/admin">← Späť do administrácie</a></nav>
  <section class="info-card">
    <h1>Mailové šablóny</h1>
    <p class="page-lead">Vyberte šablónu na úpravu.</p>
    {include '_navigation.latte', current: 'paid'}
  </section>
  <section class="info-card">
    <h2>Potvrdenie prijatia platby</h2>
    <p class="booking-payment__hint">Správa sa zaradí do odosielania pri prvom označení potvrdenej rezervácie ako zaplatenej. PDF faktúra sa prikladá automaticky, keď sú pripravené údaje na jej vystavenie.</p>
    <p class="booking-payment__hint">Značky: <code>{= '{{booking_id}}'}</code>, <code>{= '{{guest_name}}'}</code>, <code>{= '{{arrival}}'}</code>, <code>{= '{{departure}}'}</code>, <code>{= '{{amount}}'}</code>, <code>{= '{{invoice_number}}'}</code>.</p>
    {foreach $flashes as $flash}<p role="status" class="booking-payment__notice">{$flash->message}</p>{/foreach}
    <div class="cms-form booking-payment-settings__form">
      {form paidTemplateForm}
        <ul class="cms-form-errors" n:if="$form->hasErrors()"><li n:foreach="$form->getErrors() as $error">{$error}</li></ul>
        {label subject /}{input subject}
        {label body /}{input body}
        <div>{input show_logo}{label show_logo /}</div>
        <div>{input save} {input restore}</div>
      {/form}
    </div>
    <h3>Náhľad šablóny (iba fiktívne údaje)</h3>
    <p><strong>Predmet:</strong> {$emailPreviewSubject}</p>
    <iframe title="Náhľad potvrdenia úhrady" sandbox="" srcdoc="{$emailPreviewHtml}" style="width:100%;min-height:450px;border:1px solid #ddd;border-radius:10px;background:#fff"></iframe>
  </section>
</main>
{/block}
