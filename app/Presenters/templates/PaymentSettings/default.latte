{layout '../@admin.latte'}
{block pageTitle}Platobné údaje{/block}
{block content}
<main class="container inner-page cms-editor booking-payment-settings">
  <nav aria-label="Administrácia"><a class="back-link" href="/admin/bookings">← Späť na rezervácie</a></nav>
  <section class="info-card">
    <h1>Platobné údaje</h1>
    <p class="page-lead">Údaje pre manuálne bankové prevody. Zmeny sa použijú pri budúcom vytváraní platobných pokynov.</p>
    {foreach $flashes as $flash}<p role="status" class="booking-payment__notice">{$flash->message}</p>{/foreach}
    <div class="cms-form booking-payment-settings__form">
      {form settingsForm}
        <ul class="cms-form-errors" n:if="$form->hasErrors()">
          <li n:foreach="$form->getErrors() as $error">{$error}</li>
        </ul>
        {label account_holder /}{input account_holder}
        {label iban /}{input iban}
        <p class="booking-payment__hint">Zadaj vlastný platný IBAN. Žiadne bankové údaje sa nepredvyplnia automaticky.</p>
        {label bic /}{input bic}
        {input save}
      {/form}
    </div>
  </section>
  <section class="info-card" aria-labelledby="payment-email-heading">
    <h2 id="payment-email-heading">E-mail s platobnými pokynmi</h2>
    <p class="page-lead">Zmeňte text, ktorý dostane hosť po manuálnom odoslaní platobných pokynov. Formátovanie: <code>**tučné**</code>, <code>*kurzíva*</code>, nadpis <code># </code> a odseky. Vlastné HTML a odkazy nie sú povolené.</p>
    <p class="booking-payment__hint">Dostupné značky: <code>{= '{{booking_id}}'}</code>, <code>{= '{{holder}}'}</code>, <code>{= '{{iban}}'}</code>, <code>{= '{{bic}}'}</code>, <code>{= '{{amount}}'}</code>, <code>{= '{{variable_symbol}}'}</code>. Príjemca, IBAN, suma a VS musia zostať v texte.</p>
    <div class="cms-form booking-payment-settings__form">
      {form emailTemplateForm}
        <ul class="cms-form-errors" n:if="$form->hasErrors()">
          <li n:foreach="$form->getErrors() as $error">{$error}</li>
        </ul>
        {label subject /}{input subject}
        {label body /}{input body}
        <div>{input show_logo}{label show_logo /}</div>
        <div>{input save} {input restore}</div>
      {/form}
    </div>
    <h3>Náhľad uloženého e-mailu (ilustračné údaje)</h3>
    <p><strong>Predmet:</strong> {$emailPreviewSubject}</p>
    <iframe title="Náhľad platobného e-mailu" sandbox="" srcdoc="{$emailPreviewHtml}" style="width:100%;min-height:450px;border:1px solid #ddd;border-radius:10px;background:#fff"></iframe>
    <p class="booking-payment__hint">Náhľad sa aktualizuje po uložení. Logo sa v skutočnom e-maile priloží z existujúceho súboru webu.</p>
  </section>
</main>
{/block}
