{layout '../@admin.latte'}
{block pageTitle}Platobné údaje{/block}
{block content}
<main class="container inner-page cms-editor booking-payment-settings">
  <nav aria-label="Administrácia"><a class="back-link" href="/admin/bookings">← Späť na rezervácie</a></nav>
  <section class="info-card">
    <h1>Platobné údaje</h1>
    <p class="page-lead">Údaje pre manuálne bankové prevody. Zmeny sa použijú pri budúcom vytváraní platobných pokynov.</p>
    {foreach $flashes as $flash}<p role="status" class="booking-payment__notice">{$flash->message}</p>{/foreach}
    <div class="cms-form booking-payment-settings__form">
      {form settingsForm}
        <ul class="cms-form-errors" n:if="$form->hasErrors()">
          <li n:foreach="$form->getErrors() as $error">{$error}</li>
        </ul>
        {label account_holder /}{input account_holder}
        {label iban /}{input iban}
        <p class="booking-payment__hint">Zadaj vlastný platný IBAN. Žiadne bankové údaje sa nepredvyplnia automaticky.</p>
        {label bic /}{input bic}
        {input save}
      {/form}
    </div>
  </section>
</main>
{/block}
