{layout '../@admin.latte'}

{block pageTitle}Kalendár rezervácií{/block}

{block content}
<main class="container inner-page booking-calendar-admin">
  <nav aria-label="Administrácia">
    <a class="back-link" href="/admin">← Administrácia</a>
  </nav>

  <div class="booking-calendar-admin__heading">
    <div>
      <h1>Kalendár rezervácií</h1>
      <p class="page-lead">Čakajúce a potvrdené rezervácie v mesačnom prehľade.</p>
    </div>
    <nav class="booking-view-toggle" aria-label="Režim zobrazenia rezervácií">
      <a class="booking-view-toggle__option" href="/admin/bookings" aria-label="Tabuľka rezervácií">▤ Tabuľka</a>
      <span class="booking-view-toggle__option booking-view-toggle__option--active" aria-current="page">▦ Kalendár</span>
    </nav>
  </div>

  <section class="booking-calendar-admin__panel" aria-labelledby="calendar-month-title">
    <div class="booking-calendar-admin__navigation">
      <a class="booking-calendar-admin__arrow" href="?month={$previousMonth}" aria-label="Predchádzajúci mesiac">←</a>
      <h2 id="calendar-month-title">{$monthTitle}</h2>
      <a class="booking-calendar-admin__arrow" href="?month={$nextMonth}" aria-label="Nasledujúci mesiac">→</a>
    </div>

    <div class="booking-calendar-admin__legend" aria-label="Význam farieb">
      <span><i class="booking-calendar-admin__swatch booking-calendar-admin__swatch--pending" aria-hidden="true"></i> Čaká na potvrdenie ({$pendingCount})</span>
      <span><i class="booking-calendar-admin__swatch booking-calendar-admin__swatch--confirmed" aria-hidden="true"></i> Potvrdená · zaplatená</span>
      <span><i class="booking-calendar-admin__swatch booking-calendar-admin__swatch--unpaid" aria-hidden="true"></i> Potvrdená · nezaplatená</span>
      <span class="booking-calendar-admin__legend-note">Odchodový deň je voľný, ak v ňom nezačína iný pobyt.</span>
    </div>

    <div class="booking-calendar-admin__desktop">
      <div class="booking-calendar-admin__weekdays" aria-hidden="true">
        <span>Po</span><span>Ut</span><span>St</span><span>Št</span><span>Pi</span><span>So</span><span>Ne</span>
      </div>
      <div class="booking-calendar-admin__grid">
        {foreach $days as $day}
          <div class="booking-calendar-admin__day {$day['inMonth'] ? '' : 'booking-calendar-admin__day--outside'} {$day['today'] ? 'booking-calendar-admin__day--today' : ''}">
            <span class="booking-calendar-admin__date">{$day['day']}</span>
            {foreach $day['items'] as $item}
              <details class="booking-calendar-admin__preview booking-calendar-admin__preview--{$item['status']}">
                <summary class="booking-calendar-admin__event booking-calendar-admin__event--{$item['status'] === 'pending' ? 'pending' : ($item['paymentStatus'] === 'paid' ? 'confirmed' : 'unpaid')}" aria-label="Náhľad rezervácie číslo {$item['id']}">
                  {if $item['arrival']}<strong>Príchod · </strong>{/if}
                  #{$item['id']} {$item['guest']}
                </summary>
                {include reservationPreview, item: $item}
              </details>
            {/foreach}
          </div>
        {/foreach}
      </div>
    </div>

    <div class="booking-calendar-admin__mobile">
      {if count($agenda) === 0}
        <p>V tomto mesiaci nie sú žiadne čakajúce ani potvrdené pobyty.</p>
      {else}
        {foreach $agenda as $day}
          <div class="booking-calendar-admin__agenda-day">
            <strong>{$day['day']}. {$monthTitle}</strong>
            {foreach $day['items'] as $item}
              <details class="booking-calendar-admin__preview booking-calendar-admin__preview--{$item['status']}">
                <summary class="booking-calendar-admin__event booking-calendar-admin__event--{$item['status'] === 'pending' ? 'pending' : ($item['paymentStatus'] === 'paid' ? 'confirmed' : 'unpaid')}" aria-label="Náhľad rezervácie číslo {$item['id']}">
                  {if $item['arrival']}<strong>Príchod · </strong>{/if}
                  #{$item['id']} {$item['guest']}
                </summary>
                {include reservationPreview, item: $item}
              </details>
            {/foreach}
          </div>
        {/foreach}
      {/if}
    </div>
    <p class="booking-calendar-admin__note">Zamietnuté a zrušené rezervácie nie sú v kalendári zobrazené; nájdeš ich v tabuľkovom prehľade.</p>
  </section>
</main>
<script src="/assets/js/booking-calendar-admin.js" defer></script>
{/block}

{define reservationPreview $item}
  <div class="booking-calendar-admin__popup" role="group" aria-label="Náhľad rezervácie číslo {$item['id']}">
    <button type="button" class="booking-calendar-admin__popup-close" aria-label="Zavrieť náhľad rezervácie" title="Zavrieť náhľad">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
    <div class="booking-calendar-admin__popup-heading">
      <strong>Rezervácia č. {$item['id']}</strong>
      <div class="booking-calendar-admin__popup-stay">
        <span>{$item['start']|date:'d. m. Y'} – {$item['end']|date:'d. m. Y'}</span>
        <span class="booking-calendar-admin__nights">{$item['nights']} {if $item['nights'] === 1}noc{elseif $item['nights'] >= 2 && $item['nights'] <= 4}noci{else}nocí{/if}</span>
      </div>
    </div>

    <dl class="booking-calendar-admin__popup-fields">
      <div class="booking-calendar-admin__field"><dt>Hosť</dt><dd>{$item['guest']}</dd></div>
      {if $item['status'] === 'confirmed'}<div class="booking-calendar-admin__field"><dt>Úhrada</dt><dd>{if $item['paymentStatus'] === 'paid'}Zaplatená{else}Nezaplatená{/if}</dd></div>{/if}
      {if $item['email'] !== ''}<div class="booking-calendar-admin__field"><dt>E-mail</dt><dd><a href="mailto:{$item['email']}">{$item['email']}</a></dd></div>{/if}
      {if $item['phone'] !== ''}<div class="booking-calendar-admin__field"><dt>Telefón</dt><dd><a href="tel:{$item['phone']}">{$item['phone']}</a></dd></div>{/if}
    </dl>

    {if $item['note'] !== ''}
      <div class="booking-calendar-admin__preview-note">
        <span class="booking-calendar-admin__section-label">Poznámka hosťa</span>
        <p>{$item['note']}</p>
      </div>
    {/if}

    <div class="booking-calendar-admin__extras-section">
      <span class="booking-calendar-admin__section-label">Objednané doplnky</span>
      {if $item['quoteState'] === 'available'}
        {if $item['quoteExtras'] === []}
          <p class="booking-calendar-admin__empty">Bez doplnkov</p>
        {else}
          <div class="booking-calendar-admin__extras-list">
            {foreach $item['quoteExtras'] as $extra}
              <div class="booking-calendar-admin__extra">
                <span class="booking-calendar-admin__extra-icon" aria-hidden="true">
                  {if $extra['code'] === 'wellness'}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0"/><path d="M4 21c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0"/><path d="M8 13c-3-3 3-4 0-7M14 13c-3-3 3-4 0-7M20 13c-3-3 3-4 0-7"/></svg>
                  {elseif $extra['code'] === 'breakfast'}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h13v6a6.5 6.5 0 0 1-13 0V9Z"/><path d="M17 10h2a3 3 0 0 1 0 6h-2M4 21h15"/><path d="M8 3v3M13 3v3"/></svg>
                  {elseif $extra['code'] === 'romance'}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg>
                  {elseif $extra['code'] === 'frizzante'}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l-1.2 8a5 5 0 0 1-9.6 0L6 3ZM12 16v5M7 21h10M8 8h8"/></svg>
                  {elseif $extra['code'] === 'canvas_bag'}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16l-1 13H5L4 8ZM8 9V6a4 4 0 0 1 8 0v3"/></svg>
                  {else}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M7 12h10"/></svg>
                  {/if}
                </span>
                <span class="booking-calendar-admin__extra-name">{$extra['label']}</span>
                <span class="booking-calendar-admin__extra-count">× {$extra['quantity']}</span>
              </div>
            {/foreach}
          </div>
        {/if}
        <div class="booking-calendar-admin__popup-total">
          <span>Orientačná cena</span>
          <strong>{$item['quoteTotal']}</strong>
        </div>
      {elseif $item['quoteState'] === 'invalid'}
        <p class="booking-calendar-admin__empty">Cenový rozpis nie je platný. Skontroluj detail rezervácie.</p>
      {else}
        <p class="booking-calendar-admin__empty">Staršia rezervácia bez cenového rozpisu.</p>
      {/if}
    </div>
    <a class="button button-small booking-calendar-admin__detail-link" href="/admin/bookings/{$item['id']}">Otvoriť detail a akcie</a>
  </div>
{/define}
