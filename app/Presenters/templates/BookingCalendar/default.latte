{layout '../@admin.latte'}

{block pageTitle}Kalendár rezervácií{/block}

{block content}
<main class="container inner-page booking-calendar-admin">
  <nav aria-label="Administrácia">
    <a class="back-link" href="/admin">← Administrácia</a>
  </nav>

  <div class="booking-calendar-admin__heading">
    <div>
      <h1>Kalendár rezervácií</h1>
      <p class="page-lead">Čakajúce a potvrdené rezervácie v mesačnom prehľade.</p>
    </div>
    <nav class="booking-view-toggle" aria-label="Režim zobrazenia rezervácií">
      <a class="booking-view-toggle__option" href="/admin/bookings" aria-label="Tabuľka rezervácií">▤ Tabuľka</a>
      <span class="booking-view-toggle__option booking-view-toggle__option--active" aria-current="page">▦ Kalendár</span>
    </nav>
  </div>

  <section class="booking-calendar-admin__panel" aria-labelledby="calendar-month-title">
    <div class="booking-calendar-admin__navigation">
      <a class="booking-calendar-admin__arrow" href="?month={$previousMonth}" aria-label="Predchádzajúci mesiac">←</a>
      <h2 id="calendar-month-title">{$monthTitle}</h2>
      <a class="booking-calendar-admin__arrow" href="?month={$nextMonth}" aria-label="Nasledujúci mesiac">→</a>
    </div>

    <div class="booking-calendar-admin__legend" aria-label="Význam farieb">
      <span><i class="booking-calendar-admin__swatch booking-calendar-admin__swatch--pending" aria-hidden="true"></i> Čaká na potvrdenie ({$pendingCount})</span>
      <span><i class="booking-calendar-admin__swatch booking-calendar-admin__swatch--confirmed" aria-hidden="true"></i> Potvrdená ({$confirmedCount})</span>
      <span class="booking-calendar-admin__legend-note">Odchodový deň je voľný, ak v ňom nezačína iný pobyt.</span>
    </div>

    <div class="booking-calendar-admin__desktop">
      <div class="booking-calendar-admin__weekdays" aria-hidden="true">
        <span>Po</span><span>Ut</span><span>St</span><span>Št</span><span>Pi</span><span>So</span><span>Ne</span>
      </div>
      <div class="booking-calendar-admin__grid">
        {foreach $days as $day}
          <div class="booking-calendar-admin__day {$day['inMonth'] ? '' : 'booking-calendar-admin__day--outside'} {$day['today'] ? 'booking-calendar-admin__day--today' : ''}">
            <span class="booking-calendar-admin__date">{$day['day']}</span>
            {foreach $day['items'] as $item}
              <details class="booking-calendar-admin__preview booking-calendar-admin__preview--{$item['status']}">
                <summary class="booking-calendar-admin__event booking-calendar-admin__event--{$item['status']}" aria-label="Náhľad rezervácie číslo {$item['id']}">
                  {if $item['arrival']}<strong>Príchod · </strong>{/if}
                  #{$item['id']} {$item['guest']}
                </summary>
                {include reservationPreview, item: $item}
              </details>
            {/foreach}
          </div>
        {/foreach}
      </div>
    </div>

    <div class="booking-calendar-admin__mobile">
      {if count($agenda) === 0}
        <p>V tomto mesiaci nie sú žiadne čakajúce ani potvrdené pobyty.</p>
      {else}
        {foreach $agenda as $day}
          <div class="booking-calendar-admin__agenda-day">
            <strong>{$day['day']}. {$monthTitle}</strong>
            {foreach $day['items'] as $item}
              <details class="booking-calendar-admin__preview booking-calendar-admin__preview--{$item['status']}">
                <summary class="booking-calendar-admin__event booking-calendar-admin__event--{$item['status']}" aria-label="Náhľad rezervácie číslo {$item['id']}">
                  {if $item['arrival']}<strong>Príchod · </strong>{/if}
                  #{$item['id']} {$item['guest']}
                </summary>
                {include reservationPreview, item: $item}
              </details>
            {/foreach}
          </div>
        {/foreach}
      {/if}
    </div>
    <p class="booking-calendar-admin__note">Zamietnuté a zrušené rezervácie nie sú v kalendári zobrazené; nájdeš ich v tabuľkovom prehľade.</p>
  </section>
</main>
{/block}

{define reservationPreview $item}
  <div class="booking-calendar-admin__popup">
    <strong>Rezervácia č. {$item['id']}</strong>
    <dl>
      <div><dt>Hosť</dt><dd>{$item['guest']}</dd></div>
      <div><dt>Stav</dt><dd>{$item['status'] === 'pending' ? 'Čaká na potvrdenie' : 'Potvrdená'}</dd></div>
      <div><dt>Termín</dt><dd>{$item['start']|date:'d. m. Y'} – {$item['end']|date:'d. m. Y'}</dd></div>
      <div><dt>E-mail</dt><dd><a href="mailto:{$item['email']}">{$item['email']}</a></dd></div>
      {if $item['phone'] !== ''}<div><dt>Telefón</dt><dd><a href="tel:{$item['phone']}">{$item['phone']}</a></dd></div>{/if}
      {if $item['note'] !== ''}<div><dt>Poznámka</dt><dd>{$item['note']}</dd></div>{/if}
    </dl>
    <a class="button button-small" href="/admin/bookings/{$item['id']}">Otvoriť detail a akcie</a>
  </div>
{/define}
