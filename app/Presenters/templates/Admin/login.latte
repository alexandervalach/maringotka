{layout none}
<!doctype html>
<html lang="sk">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="referrer" content="no-referrer">
    <title>Prihlásenie do administrácie – Maringotka na Závadke</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; background: #f5f2ec; color: #1f3126; font: 16px/1.5 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        .auth-card { width: min(100%, 29rem); padding: clamp(1.5rem, 5vw, 3rem); background: #fff; border: 1px solid #ecece8; border-radius: 1.15rem; box-shadow: 0 16px 44px rgba(31, 49, 38, .09); }
        .brand { display: flex; align-items: center; gap: .8rem; margin-bottom: 2rem; }
        .brand-mark { display: grid; place-items: center; width: 3.15rem; height: 3.15rem; border-radius: .9rem; background: #e9efe7; color: #405e48; font-size: 1.6rem; font-weight: 700; }
        .brand-name { display: block; font-size: .98rem; font-weight: 750; letter-spacing: -.015em; }
        .brand-caption { display: block; font-size: .8rem; color: #6b776e; }
        h1 { margin: 0; font-size: 1.65rem; letter-spacing: -.035em; line-height: 1.2; }
        .intro { margin: .65rem 0 1.8rem; font-size: .94rem; color: #657168; }
        .field { margin: 0 0 1.25rem; }
        .field label { display: block; margin-bottom: .42rem; font-size: .89rem; font-weight: 650; }
        .field input { display: block; width: 100%; min-height: 3rem; padding: .72rem .85rem; border: 1px solid #c5cec6; border-radius: .55rem; background: #fff; color: #1f3126; font: inherit; transition: border-color .12s, box-shadow .12s; }
        .field input:hover { border-color: #839889; }
        .field input:focus-visible { border-color: #405e48; outline: 3px solid #d4e6d8; outline-offset: 1px; }
        .submit-button { display: block; width: 100%; min-height: 3.05rem; margin-top: .5rem; border: none; border-radius: .55rem; background: #405e48; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
        .submit-button:hover { background: #304c38; }
        .submit-button:focus-visible { outline: 3px solid #a6bfa7; outline-offset: 3px; }
        .errors { margin: 0 0 1.4rem; padding: .85rem 1rem .85rem 2rem; background: #fff0ee; border: 1px solid #efceca; border-radius: .5rem; color: #9b2924; font-size: .87rem; }
        .field-error { display: block; margin-top: .4rem; color: #9b2924; font-size: .83rem; }
        .hint { margin: 1.5rem 0 0; color: #6b776e; font-size: .8rem; text-align: center; }
        @media (max-width: 420px) { .auth-card { padding: 1.5rem; } }
    </style>
</head>
<body>
<main class="auth-card">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">M</span>
        <div>
            <span class="brand-name">Maringotka na Závadke</span>
            <span class="brand-caption">Administrácia</span>
        </div>
    </div>
    <h1>Prihlásenie</h1>

    {form loginForm, class: "auth-form"}
        <ul class="errors" n:ifcontent role="alert">
            <li n:foreach="$form->getOwnErrors() as $error">{$error}</li>
        </ul>
        <div class="field">
            {label username /}
            {input username, autofocus: true}
            <span class="field-error" n:ifcontent>{inputError username}</span>
        </div>
        <div class="field">
            {label password /}
            {input password}
            <span class="field-error" n:ifcontent>{inputError password}</span>
        </div>
        {input submit, class: "submit-button"}
    {/form}
    <p class="hint">Prístup len pre oprávneného správcu.</p>
</main>
</body>
</html>
