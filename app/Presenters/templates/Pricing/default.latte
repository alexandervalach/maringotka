{block content}
<main id="main" class="inner-page container">
  <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
  <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
  <h1>{_'messages.navigation.pricing'}</h1>
  <p class="page-lead">{_'messages.pricing.currentIntro'}</p>

  <div class="price-cards">
    <article class="info-card">
      <h2>{_'messages.pricing.firstNight'}</h2>
      <p class="price-value">{$prices['first_night']} €</p>
    </article>
    <article class="info-card">
      <h2>{_'messages.pricing.additionalNight'}</h2>
      <p class="price-value">{$prices['additional_night']} €</p>
    </article>
  </div>

  <h2 class="section-heading">{_'messages.pricing.extras'}</h2>
  <div class="price-list">
    <div><span>{_'messages.pricing.wellness'}</span><strong>{$prices['wellness']} € / {_'messages.pricing.day'}</strong></div>
    <div><span>{_'messages.pricing.breakfastTwo'}</span><strong>{$prices['breakfast']} € / {_'messages.pricing.day'}</strong></div>
    <div><span>{_'messages.pricing.bikes'}</span><strong>{_'messages.pricing.bikesSpring2027'}</strong></div>
    <div><span>{_'messages.pricing.romanceDetails'}</span><strong>{$prices['romance']} €</strong></div>
  </div>

  <h2 class="section-heading">{_'messages.pricing.products'}</h2>
  <div class="pricing-products">
    <article class="pricing-product">
      <img
        src="/assets/images/pricing/frizzante.jpg"
        alt="{_'messages.pricing.frizzante'}"
        loading="lazy"
        decoding="async"
        width="896"
        height="1195"
      >
      <div class="pricing-product__details">
        <h3>{_'messages.pricing.frizzante'}</h3>
        <strong class="pricing-product__price">10 €</strong>
      </div>
    </article>
    <article class="pricing-product">
      <img
        src="/assets/images/pricing/canvas-bag.jpg"
        alt="{_'messages.pricing.canvasBag'}"
        loading="lazy"
        decoding="async"
        width="896"
        height="1195"
      >
      <div class="pricing-product__details">
        <h3>{_'messages.pricing.canvasBag'}</h3>
        <strong class="pricing-product__price">5 €</strong>
      </div>
    </article>
  </div>

</main>
{/block}
