{layout none}
<!doctype html>
<html lang="sk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Úprava cenníka – Maringotka na Závadke</title>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<main id="main" class="container inner-page cms-editor">
  <nav aria-label="Administrácia">
    <a class="back-link" href="/admin">← Administrácia</a>
    <a class="back-link" href="/cennik">Slovenská stránka</a>
    <a class="back-link" href="/en/pricing">English page</a>
  </nav>
  <section class="info-card">
    <h1>Cenník</h1>
    <p class="page-lead">Ceny sú spoločné pre všetky jazyky.</p>
    {foreach $flashes as $flash}
      <p role="status" class="subtle-note">{$flash->message}</p>
    {/foreach}
    <div class="cms-form">
      {form pricingForm}
        <ul class="cms-form-errors" n:if="$form->hasErrors()">
          <li n:foreach="$form->getErrors() as $error">{$error}</li>
        </ul>
        {label first_night /}
        {input first_night}
        {label additional_night /}
        {input additional_night}
        {label wellness /}
        {input wellness}
        {label breakfast /}
        {input breakfast}
        {label romance /}
        {input romance}
        {label minimum_nights /}
        {input minimum_nights, class => 'field'}
        {input save}
      {/form}
    </div>
  </section>
</main>
</body>
</html>
