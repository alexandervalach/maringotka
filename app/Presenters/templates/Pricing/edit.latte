{layout '../@admin.latte'}

{block pageTitle}Úprava cenníka{/block}

{block content}
<main id="main" class="container inner-page cms-editor">
  <nav aria-label="Administrácia">
    <a class="back-link" href="/admin">← Administrácia</a>
    <a class="back-link" href="/cennik">Slovenská stránka</a>
    <a class="back-link" href="/en/pricing">English page</a>
  </nav>
  <section class="info-card">
    <h1>Cenník</h1>
    <p class="page-lead">Ceny sú spoločné pre všetky jazyky. Po uložení sa hneď zobrazia na verejnom webe.</p>
    <p class="subtle-note">Sezónne ceny a požičovňa bicyklov sa zatiaľ neupravujú týmto formulárom.</p>

    {include '../_adminFlashes.latte'}
    <div class="cms-form">
      {form pricingForm}
        <ul class="cms-form-errors" n:if="$form->hasErrors()">
          <li n:foreach="$form->getErrors() as $error">{$error}</li>
        </ul>
        {label first_night /}
        {input first_night}
        {label additional_night /}
        {input additional_night}
        {label wellness /}
        {input wellness}
        {label breakfast /}
        {input breakfast}
        {label romance /}
        {input romance}
        {label minimum_nights /}
        {input minimum_nights}
        {input save}
      {/form}
    </div>
  </section>
</main>
{/block}
