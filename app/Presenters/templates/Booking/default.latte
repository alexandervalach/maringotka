{block content}
<main id="main" class="inner-page container">
  <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
  <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
  {if $locale === 'en'}
    <h1>Reservation request</h1>
    <p class="page-lead">Select arrival and departure dates. A request is not a confirmed booking.</p>
    <p>Minimum stay: {$minimumNights} {if $minimumNights === 1}night{else}nights{/if}.</p>
  {else}
    <h1>Žiadosť o rezerváciu</h1>
    <p class="page-lead">Vyberte termín pobytu. Žiadosť nie je automatickým potvrdením rezervácie.</p>
    <p>Minimálny pobyt: {$minimumNights} {if $minimumNights === 1}noc{else}nocí{/if}.</p>
  {/if}
  {if $requestSubmitted}
    <div class="booking-feedback" role="status" aria-live="polite">
      <div class="booking-feedback-message booking-feedback-success">
        {if $locale === 'en'}
          <p><strong>Request received.</strong> Your reservation request is awaiting approval; it is not confirmed yet.</p>
        {else}
          <p><strong>Žiadosť bola prijatá.</strong> Termín čaká na schválenie. Rezervácia zatiaľ nie je potvrdená.</p>
        {/if}
      </div>
    </div>
  {else}
  {if $flashes}
    <div class="booking-feedback" role="status" aria-live="polite">
      {foreach $flashes as $flash}
        <div class="booking-feedback-message booking-feedback-{$flash->type}">
          <p>{$flash->message}</p>
        </div>
      {/foreach}
    </div>
  {/if}
  {* Progressive enhancement: without JS the original native date fields still work. *}
  <div class="booking-calendar"
    data-today="{$calendarToday}"
    data-until="{$calendarUntil}"
    data-min-nights="{$minimumNights}"
    data-locale="{$locale}"
    aria-label="{if $locale === 'en'}Availability calendar{else}Kalendár dostupnosti{/if}">
    <h2>{if $locale === 'en'}Available dates{else}Dostupné termíny{/if}</h2>
    <p class="booking-calendar-intro">
      {if $locale === 'en'}Choose check-in and check-out on the calendar. Occupied nights are marked; check-out on the next guest's arrival date is allowed.{else}Vyberte príchod a odchod v kalendári. Obsadené noci sú vyznačené; odchod v deň príchodu ďalšieho hosťa je možný.{/if}
    </p>
    <div class="booking-calendar-intervals" hidden>
      {foreach $blockedIntervals as $interval}
        <span data-start="{$interval['start']}" data-end="{$interval['end']}"></span>
      {/foreach}
    </div>
    <div class="booking-calendar-controls" hidden>
      <button type="button" class="booking-calendar-prev" aria-label="{if $locale === 'en'}Previous month{else}Predchádzajúci mesiac{/if}">‹</button>
      <strong class="booking-calendar-month" aria-live="polite"></strong>
      <button type="button" class="booking-calendar-next" aria-label="{if $locale === 'en'}Next month{else}Nasledujúci mesiac{/if}">›</button>
    </div>
    <div class="booking-calendar-days" hidden></div>
    <p class="booking-calendar-message" role="status" aria-live="polite"></p>
    <button type="button" class="booking-calendar-reset back-link" hidden>
      {if $locale === 'en'}Clear selected dates{else}Zrušiť výber termínu{/if}
    </button>
    <p class="booking-calendar-legend"><span class="booking-calendar-occupied-swatch"></span> {if $locale === 'en'}Occupied{else}Obsadené{/if}</p>
  </div>
  <div class="cms-form booking-form">
    {form bookingForm}
      <div n:if="$form->hasErrors()" class="booking-feedback" role="alert">
        <div n:foreach="$form->getErrors() as $error" class="booking-feedback-message booking-feedback-error">
          <p>{$error}</p>
        </div>
      </div>
      <div class="booking-field">
        {label arrival_date /}
        {input arrival_date}
      </div>
      <div class="booking-field">
        {label departure_date /}
        {input departure_date}
      </div>
      <section class="booking-quote" data-booking-quote
        data-first-night="{$bookingPrices['first_night']}"
        data-additional-night="{$bookingPrices['additional_night']}"
        data-wellness="{$bookingPrices['wellness']}"
        data-breakfast="{$bookingPrices['breakfast']}"
        data-romance="{$bookingPrices['romance']}"
        data-frizzante="1000"
        data-canvas-bag="500"
        data-min-nights="{$minimumNights}"
        data-max-nights="{$maxNights}"
        data-locale="{$locale}">
        <h2>{if $locale === 'en'}Your stay and extras{else}Pobyt a doplnkové služby{/if}</h2>
        <p class="booking-quote__intro">{if $locale === 'en'}Basic stay. Optional services are added to the accommodation price.{else}Základný pobyt. Doplnkové služby sa pripočítajú k cene ubytovania.{/if}</p>
        <div class="booking-quote__options">
          <div class="booking-quote__option">{input wellness}{label wellness /}<span>{if $locale === 'en'}€{$bookingPrices['wellness'] / 100} / night{else}{$bookingPrices['wellness'] / 100} € / noc{/if}</span></div>
          <div class="booking-quote__option">{input breakfast}{label breakfast /}<span>{if $locale === 'en'}€{$bookingPrices['breakfast'] / 100} / night{else}{$bookingPrices['breakfast'] / 100} € / noc{/if}</span></div>
          <div class="booking-quote__option">{input romance}{label romance /}<span>{if $locale === 'en'}€{$bookingPrices['romance'] / 100} / stay{else}{$bookingPrices['romance'] / 100} € / pobyt{/if}</span></div>
          <div class="booking-quote__quantity">{label frizzante /}{input frizzante}<span>10 € / {if $locale === 'en'}bottle{else}fľaša{/if}</span></div>
          <div class="booking-quote__quantity">{label canvas_bag /}{input canvas_bag}<span>5 € / {if $locale === 'en'}item{else}kus{/if}</span></div>
        </div>
        <p class="booking-quote__unavailable">{if $locale === 'en'}Bicycle rental – coming spring 2027.{else}Požičanie bicyklov – pripravujeme na jar 2027.{/if}</p>
        <div class="booking-quote__summary" role="status" aria-live="polite">
          <div><span>{if $locale === 'en'}Nights{else}Počet nocí{/if}</span><strong data-quote-nights>–</strong></div>
          <div><span>{if $locale === 'en'}Accommodation{else}Ubytovanie{/if}</span><strong data-quote-accommodation>–</strong></div>
          <div><span>{if $locale === 'en'}Extras{else}Doplnky{/if}</span><strong data-quote-extras>–</strong></div>
          <div class="booking-quote__total"><span>{if $locale === 'en'}Estimated total{else}Orientačná cena spolu{/if}</span><strong data-quote-total>–</strong></div>
        </div>
        <p class="booking-quote__notice">{if $locale === 'en'}The amount is indicative. The request is not a confirmed reservation.{else}Cena je orientačná. Žiadosť nie je potvrdená rezervácia.{/if}</p>
      </section>
      <div class="booking-field">
        {label guest_name /}
        {input guest_name}
      </div>
      <div class="booking-field">
        {label guest_email /}
        {input guest_email}
      </div>
      <div class="booking-field">
        {label guest_phone /}
        {input guest_phone}
      </div>
      <div class="booking-field">
        {label guest_note /}
        {input guest_note}
      </div>
      <div class="booking-submit">
        {input send}
      </div>
    {/form}
  </div>
  {/if}
</main>
  <link rel="stylesheet" href="/assets/css/booking-calendar.css">
  <script src="/assets/js/booking-calendar.js" defer></script>
  <script src="/assets/js/booking-quote.js" defer></script>
{/block}
