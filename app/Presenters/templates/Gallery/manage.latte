{layout none}
<!doctype html>
<html lang="sk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Galéria – Maringotka na Závadke</title>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<main id="main" class="container inner-page cms-editor">
  <a class="back-link" href="/admin">← Administrácia</a>
  <section class="info-card">
    <h1>Galéria</h1>
    <p class="page-lead">Uprav poradie, viditeľnosť a alternatívne texty existujúcich fotografií.</p>
    <div class="gallery-grid">
      {foreach $photos as $photo}
        <div class="gallery-photo">
          <img src="/assets/images/media/{$photo['fallback']}" alt="" loading="lazy" style="width:100%;height:auto">
          <p>Poradie: {$photo['position']} · {$photo['is_visible'] ? 'Viditeľná' : 'Skrytá'}</p>
          {if $photo['id'] > 0}<a class="button" href="/admin/gallery/{$photo['id']}">Upraviť</a>{/if}
        </div>
      {/foreach}
    </div>
  </section>
</main>
</body>
</html>
