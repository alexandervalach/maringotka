{block content}
<main id="main" class="inner-page container">
  <a class="back-link" href="{$paths['default']}">← {_'messages.navigation.home'}</a>
  <p class="eyebrow inner-eyebrow">Maringotka na Závadke</p>
  <h1>{_'messages.navigation.gallery'}</h1>
  <p class="page-lead">{_'messages.sections.gallery.text'}</p>
  <div class="gallery-grid" aria-label="{_'messages.gallery.photos'}">
    {foreach $photos as $photo}
      <figure class="gallery-photo">
        <picture>
          {if $photo['srcset'] !== ''}
            <source type="image/webp" srcset="{$photo['srcset']}" sizes="(max-width: 540px) 92vw, (max-width: 800px) 45vw, 30vw">
          {/if}
          <img src="/assets/images/media/{$photo['fallback']}"
            width="{$photo['width']}" height="{$photo['height']}"
            alt="{$locale === 'en' ? ($photo['alt_en'] ?: $photo['key']) : ($photo['alt_sk'] ?: $photo['key'])}"
            loading="lazy" decoding="async">
        </picture>
      </figure>
    {/foreach}
  </div>
</main>
{/block}
