application:
  mapping:
    *: App\Presenters\*Presenter

services:
  router: App\Router\RouterFactory::createRouter
  - App\Presenters\HomepagePresenter
  - App\Infrastructure\Database\ConnectionFactory
  - App\Presenters\AdminPresenter
  - App\Model\HomepageRepository
  - App\Forms\HomepageFormFactory
  - App\Presenters\ContactPresenter
  - App\Model\ContactRepository
  - App\Forms\ContactFormFactory
  - App\Presenters\PricingPresenter
  - App\Model\PricingRepository
  - App\Forms\PricingFormFactory
  - App\Presenters\GalleryPresenter
  - App\Model\GalleryRepository
  - App\Forms\GalleryFormFactory
